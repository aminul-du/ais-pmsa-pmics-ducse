{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ],
      "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/agent-studio",
      "regex": "^/agent\\-studio(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/agent\\-studio(?:/)?$"
    },
    {
      "page": "/chat",
      "regex": "^/chat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/chat(?:/)?$"
    },
    {
      "page": "/knowledge-hub",
      "regex": "^/knowledge\\-hub(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/knowledge\\-hub(?:/)?$"
    },
    {
      "page": "/observability",
      "regex": "^/observability(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/observability(?:/)?$"
    },
    {
      "page": "/reports",
      "regex": "^/reports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/reports(?:/)?$"
    },
    {
      "page": "/sandbox",
      "regex": "^/sandbox(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sandbox(?:/)?$"
    },
    {
      "page": "/security",
      "regex": "^/security(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/security(?:/)?$"
    },
    {
      "page": "/trust",
      "regex": "^/trust(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/trust(?:/)?$"
    },
    {
      "page": "/twin",
      "regex": "^/twin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/twin(?:/)?$"
    },
    {
      "page": "/visualizations",
      "regex": "^/visualizations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/visualizations(?:/)?$"
    },
    {
      "page": "/voice-studio",
      "regex": "^/voice\\-studio(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/voice\\-studio(?:/)?$"
    },
    {
      "page": "/workflow-studio",
      "regex": "^/workflow\\-studio(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/workflow\\-studio(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}